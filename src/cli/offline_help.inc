    {"bench",
      "Usage: bubo bench [OPTIONS] [ARGS...]\n"
      "\n"
      "Benchmark prompt processing (pp) and token generation (tg) throughput.\n"
      "\n"
      "Model:\n"
      "  -m, --model <PATH>         Path to GGUF model file (required)\n"
      "\n"
      "Workload:\n"
      "  -p, --n-prompt <n,n,...>   Prompt token lengths to benchmark (default: 2048)\n"
      "  -n, --n-gen <n,n,...>      Number of text generation tokens to benchmark (default: 128)\n"
      "  -d, --n-depth <n,n,...>    Context depths prepared before timed region (default: 0)\n"
      "  -c, --concurrency <n,n,...> DS4 simultaneous requests, 1..8 (default: 1); pp is aggregate, tg per user\n"
      "  -r, --repetitions <N>      Repetitions per test point for variance reduction (default: 1)\n"
      "\n"
      "Validation:\n"
      "      --validate-prefill <N> Compare batched prefill logits against sequential reference\n"
      "      --logit-eval <TEXT>    Flash-Next: teacher-force this text file through the decode and verify arithmetic and dump per-position log-probabilities\n"
      "      --logit-out <PREFIX>   Output prefix for --logit-eval (PREFIX-s<i>.bin)\n"
      "      --logit-schedules <W:W,...> Verify-width cycles for --logit-eval, one output per schedule (default: 1:1,2,3,4,5,6,7,8); a 'p' prefix (p8) uses the prefill arithmetic\n"
      "\n"
      "Speculative:\n"
      "      --speculative <MODE>   Draft backend: dflash2, mtp, dspark, or off\n"
      "      --dflash-model <PATH>  Path to Qwen DFlash2 GGUF file\n"
      "      --draft-policy <POLICY> Draft length: DFlash2 fixed or adaptive (default: adaptive); Gemma 4 MTP calibrated, confidence or fixed (default: calibrated)\n"
      "      --draft-calibration <SCOPE> Gemma 4 calibrated drafting: shared (learned across requests) or request (reset per request; exact seeded replay) (default: shared)\n"
      "      --dspark-model <PATH>  DeepSeek V4 Flash DSpark support GGUF\n"
      "      --mtp-model <PATH>     Path to quantized Qwen MTP draft head GGUF file\n"
      "      --draft-tokens <N>     Maximum speculative draft tokens per verification step (default: 7; Gemma 4: 15)\n"
      "      --min-draft-tokens <N> Adaptive draft floor (default: 1)\n"
      "\n"
      "Sampling:\n"
      "      --temperature <T>      Randomness scale; 0.0 selects greedy argmax (default: 0.0)\n"
      "      --top-k <K>            Keep only the K highest-logit tokens (default: 0 = disabled)\n"
      "      --top-p <P>            Keep the smallest token set whose cumulative probability reaches P (default: 1.0 = disabled)\n"
      "      --min-p <P>            Keep tokens with probability at least P times the best token (default: 0.0 = disabled)\n"
      "      --min-keep <N>         Minimum candidates retained by enabled sampling filters (default: 0)\n"
      "      --seed <N>             RNG seed for reproducible generation (default: -1 = random)\n"
      "      --repeat-penalty <N>   Multiplicative penalty for recently used tokens (default: 1.0 = disabled)\n"
      "      --repeat-last-n <N>    Trailing token window used by repetition penalties (default: 64; 0 = disabled)\n"
      "      --frequency-penalty <N> Penalty multiplied by each token's generated occurrence count (default: 0.0 = disabled)\n"
      "      --presence-penalty <N> One-time penalty for tokens already generated in this response (default: 0.0 = disabled)\n"
      "\n"
      "General:\n"
      "  -v, --verbose              Print detailed timing, latency breakdown, and tok/s metrics\n"
      "  -h, --help                 Print help\n"},
