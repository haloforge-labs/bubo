# Intact test executable; independently remove registry, files, and Run guard.
foreach(kind registry files missing guard)
  if(kind STREQUAL "guard")
    set(path "src/cli/prepare/prepare.cpp")
    set(anchor [=[if (const auto code = CheckVcRuntime(]=])
    set(replacement [=[if (const auto code = 0; false && CheckVcRuntime(]=])
  elseif(kind STREQUAL "missing")
    set(path "src/cli/prepare/vc_runtime.cpp")
    set(anchor "int CheckVcRuntime(const VcRuntimeProbe& probe, std::ostream& err) {")
    set(replacement "${anchor}\n  return 0; // deliberately removed prerequisite check")
  else()
    set(path "src/cli/prepare/vc_runtime.cpp")
    if(kind STREQUAL "registry")
      set(anchor "probe.installed && probe.installed()")
    else()
      set(anchor "probe.system_file && probe.system_file")
    endif()
    set(replacement "false && ${anchor}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/${path}")
  file(READ "${CMAKE_SOURCE_DIR}/${path}" source)
  string(FIND "${source}" "${anchor}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "VC runtime ${kind} mutation anchor missing")
  endif()
  string(REPLACE "${anchor}" "${replacement}" source "${source}")
  set(copy "${CMAKE_CURRENT_BINARY_DIR}/vc_runtime_mutant_${kind}.cpp")
  file(WRITE "${copy}" "${source}")
  set(name "prepare_vc_runtime_mutant_${kind}")
  add_executable(${name} prepare_vc_runtime_test.cpp "${copy}")
  target_link_libraries(${name} PRIVATE bubo_prepare)
  set_target_properties(${name} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
endforeach()
