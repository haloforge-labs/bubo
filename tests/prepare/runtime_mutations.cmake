# Source copies only: intact tests/expectations must reject every mutant.
foreach(kind hash traversal rollback consent)
  if(kind STREQUAL "hash" OR kind STREQUAL "traversal")
    set(path "src/core/prepare/zip_reader.cpp")
    set(test prepare_zip_test.cpp)
    if(kind STREQUAL "hash")
      set(anchor [=[digest != expected_sha256]=])
      set(replacement [=[false /* broken SHA equality */]=])
    else()
      set(anchor [=[if (!SafeZipPath(m.name, dir))]=])
      set(replacement [=[if (false /* broken path guard */)]=])
    endif()
  else()
    set(path "src/cli/prepare/runtime_prepare.cpp")
    set(test prepare_runtime_test.cpp)
    if(kind STREQUAL "rollback")
      set(anchor "// mutation-anchor: runtime-rollback\n      Recover(root, e);")
      set(replacement "// deliberately broken: no rollback")
    else()
      set(anchor "Other AMD terms can apply to these files. Bubo cannot confirm which.")
      set(replacement "")
    endif()
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/${path}")
  file(READ "${CMAKE_SOURCE_DIR}/${path}" source)
  string(FIND "${source}" "${anchor}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "runtime ${kind} mutation anchor missing; refusing vacuous proof")
  endif()
  string(REPLACE "${anchor}" "${replacement}" source "${source}")
  set(copy "${CMAKE_CURRENT_BINARY_DIR}/runtime_mutant_${kind}.cpp")
  file(WRITE "${copy}" "${source}")
  set(name "prepare_runtime_mutant_${kind}")
  add_executable(${name} ${test} "${copy}")
  target_link_libraries(${name} PRIVATE bubo_prepare_test)
  target_compile_definitions(${name} PRIVATE
    BUBO_PREPARE_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/fixtures"
    BUBO_NOTICE_SOURCE="${CMAKE_SOURCE_DIR}/tools/release/runtime-notices")
  set_target_properties(${name} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
  if(kind STREQUAL "rollback" OR kind STREQUAL "consent")
    target_sources(${name} PRIVATE loopback_stub.cpp)
    if(WIN32)
      target_link_libraries(${name} PRIVATE ws2_32)
      add_dependencies(${name} prepare_fixture_engine)
      target_compile_definitions(${name} PRIVATE BUBO_INERT_DLL="$<TARGET_FILE:prepare_fixture_engine>")
    endif()
  endif()
endforeach()
