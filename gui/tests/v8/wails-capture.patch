diff --git a/internal/frontend/desktop/windows/winc/w32/testcapture.go b/internal/frontend/desktop/windows/winc/w32/testcapture.go
new file mode 100644
index 0000000..ed9aa25
--- /dev/null
+++ b/internal/frontend/desktop/windows/winc/w32/testcapture.go
@@ -0,0 +1,58 @@
+//go:build windows
+
+package w32
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+	"time"
+)
+
+var captureMu sync.Mutex
+
+func captureTestEvent(kind, title, text, processFailedKind string) {
+	captureMu.Lock()
+	defer captureMu.Unlock()
+	configBytes, err := os.ReadFile(os.Getenv("BUBO_TEST_CONFIG"))
+	if err != nil {
+		panic(err)
+	}
+	var config struct {
+		CaptureFile string `json:"capture_file"`
+	}
+	if err := json.Unmarshal(configBytes, &config); err != nil {
+		panic(err)
+	}
+	if config.CaptureFile == "" {
+		panic("bubo_test capture_file is empty")
+	}
+	record, err := json.Marshal(struct {
+		Kind              string `json:"kind"`
+		Title             string `json:"title"`
+		Text              string `json:"text"`
+		Time              string `json:"time"`
+		ProcessFailedKind string `json:"process_failed_kind,omitempty"`
+	}{kind, title, text, time.Now().UTC().Format(time.RFC3339Nano), processFailedKind})
+	if err != nil {
+		panic(err)
+	}
+	f, err := os.OpenFile(config.CaptureFile, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		panic(err)
+	}
+	defer f.Close()
+	if _, err := f.Write(append(record, '\n')); err != nil {
+		panic(err)
+	}
+}
+
+func CaptureMessageBox(title, text string) int {
+	captureTestEvent("wails_message_box", title, text, "")
+	return 2 // IDCANCEL: an unexpected dialog must not grant consent.
+}
+
+func CaptureProcessFailed(kind string) {
+	captureTestEvent("wails_process_failed", "", fmt.Sprintf("WebView2 process failed with kind %s", kind), kind)
+}
